from pathlib import Path

SOURCE = Path("integrated_table_a_to_b_refined_viewer.py")
OUTPUT = Path("integrated_table_a_to_b_outside_route.py")


def replace_once(text, old, new, description):
    count = text.count(old)
    if count != 1:
        raise RuntimeError(
            f"{description}: expected exactly one match, found {count}. "
            "Original script has not been modified."
        )
    return text.replace(old, new, 1)


if not SOURCE.is_file():
    raise FileNotFoundError(
        f"Cannot find {SOURCE}. Run this generator from t1_balance_v2."
    )

code = SOURCE.read_text()


# ------------------------------------------------------------
# 1. Move the box closer to the south edge of each table.
# ------------------------------------------------------------
code = replace_once(
    code,
    'CONFIG["rewards"]["episode_length_s"] = 60.0',
    'CONFIG["rewards"]["episode_length_s"] = 180.0',
    "Episode length configuration",
)

code = replace_once(
    code,
    "episode_seconds=90.0,",
    "episode_seconds=180.0,",
    "Environment episode duration",
)

code = replace_once(
    code,
    "OBJECT_POSITION = np.array([0.56, -0.20, 0.635])",
    """SOUTH_LANE_Y = -0.85
PICKUP_YAW = np.deg2rad(96.0)
OBJECT_POSITION = np.array([0.56, -0.57, 0.635])""",
    "Table A box position",
)


# ------------------------------------------------------------
# 2. Add a global-coordinate waypoint controller.
# It converts world velocity into the robot's local frame.
# ------------------------------------------------------------
waypoint_helper = r'''
        def run_teacher_waypoint(
            target_xy,
            target_yaw,
            label,
            carry=False,
            timeout_seconds=35.0,
        ):
            nonlocal phase, previous_action, max_tilt

            target_xy = np.asarray(target_xy, dtype=float)
            max_steps = max(1, round(timeout_seconds / policy_dt))
            stable_count = 0
            stable_required = max(1, round(0.12 / policy_dt))

            print("\n" + label)
            print("Target XY:", np.round(target_xy, 3))
            print("Target yaw:", round(np.degrees(target_yaw), 2))

            for step in range(max_steps):
                robot_xy = data.qpos[:2].copy()
                delta_world = target_xy - robot_xy
                distance = float(np.linalg.norm(delta_world))

                R_trunk = data.xmat[trunk_id].reshape(3, 3)
                yaw_now = float(np.arctan2(R_trunk[1, 0], R_trunk[0, 0]))
                yaw_error = (
                    target_yaw - yaw_now + np.pi
                ) % (2.0 * np.pi) - np.pi

                # Proportional world-frame movement with a speed limit.
                speed = min(0.09, 0.8 * distance)

                if distance < 0.035:
                    world_vx = 0.0
                    world_vy = 0.0
                else:
                    world_vx = delta_world[0] / distance * speed
                    world_vy = delta_world[1] / distance * speed

                # Convert world velocity into robot-local velocity.
                c = np.cos(yaw_now)
                s = np.sin(yaw_now)

                vx = c * world_vx + s * world_vy
                vy = -s * world_vx + c * world_vy

                yaw_command = float(np.clip(
                    1.5 * yaw_error, -0.15, 0.15
                ))

                if abs(yaw_error) < 0.025:
                    yaw_command = 0.0

                quat = data.sensor("orientation").data[
                    [1, 2, 3, 0]
                ].astype(np.float32)

                angular = data.sensor(
                    "angular-velocity"
                ).data.astype(np.float32)

                gravity = quat_rotate_inverse(
                    quat,
                    np.array([0., 0., -1.], dtype=np.float32),
                )

                pos = data.qpos[leg_qpos].astype(np.float32)
                vel = data.qvel[leg_qvel].astype(np.float32)

                teacher_obs = np.zeros(47, dtype=np.float32)
                teacher_obs[0:3] = gravity * norm["gravity"]
                teacher_obs[3:6] = angular * norm["ang_vel"]
                teacher_obs[6] = vx * norm["lin_vel"]
                teacher_obs[7] = vy * norm["lin_vel"]
                teacher_obs[8] = yaw_command * norm["ang_vel"]
                teacher_obs[9] = np.cos(2.0 * np.pi * phase)
                teacher_obs[10] = np.sin(2.0 * np.pi * phase)
                teacher_obs[11:23] = (
                    pos - default_pos
                ) * norm["dof_pos"]
                teacher_obs[23:35] = vel * norm["dof_vel"]
                teacher_obs[35:47] = previous_action

                with torch.no_grad():
                    action = teacher(
                        torch.from_numpy(teacher_obs).unsqueeze(0)
                    ).squeeze(0).cpu().numpy().astype(np.float32)

                action = np.clip(
                    action,
                    -norm["clip_actions"],
                    norm["clip_actions"],
                )

                _, _, terminated, truncated, _ = env.step(action)

                # Keep the box attached to the hand during carrying.
                if carry:
                    R_hand = data.xmat[hand_id].reshape(3, 3).copy()
                    data.mocap_pos[mocap_id] = (
                        palm_position(data, hand_id)
                        + R_hand @ attached_local
                    )
                    data.mocap_quat[mocap_id] = np.array(
                        [1., 0., 0., 0.]
                    )
                    mujoco.mj_forward(model, data)

                previous_action = action.copy()
                phase = (
                    phase + dt * frequency * decimation
                ) % 1.0

                R_trunk = data.xmat[trunk_id].reshape(3, 3)
                tilt = float(np.degrees(np.arccos(
                    np.clip(R_trunk[2, 2], -1.0, 1.0)
                )))
                max_tilt = max(max_tilt, tilt)

                if (step + 1) % max(1, round(1.0 / policy_dt)) == 0:
                    yaw_deg = np.degrees(
                        np.arctan2(R_trunk[1, 0], R_trunk[0, 0])
                    )
                    message = (
                        f"  t={(step + 1) * policy_dt:.1f}s | "
                        f"robot={np.round(data.qpos[:2], 3)} | "
                        f"yaw={yaw_deg:+.1f}deg | "
                        f"tilt={tilt:.2f}deg"
                    )
                    if carry:
                        message += (
                            f" | box={np.round(data.mocap_pos[mocap_id], 3)}"
                        )
                    print(message)

                if terminated or truncated or tilt > 25.0:
                    raise RuntimeError(
                        f"Waypoint stopped during {label}: "
                        f"terminated={terminated}, "
                        f"truncated={truncated}, tilt={tilt:.2f}deg"
                    )

                post_distance = float(np.linalg.norm(
                    target_xy - data.qpos[:2]
                ))

                R_post = data.xmat[trunk_id].reshape(3, 3)
                post_yaw = float(np.arctan2(R_post[1, 0], R_post[0, 0]))
                post_yaw_error = (
                    target_yaw - post_yaw + np.pi
                ) % (2.0 * np.pi) - np.pi

                if post_distance < 0.075 and abs(post_yaw_error) < 0.10:
                    stable_count += 1
                else:
                    stable_count = 0

                if stable_count >= stable_required:
                    break

            final_distance = float(np.linalg.norm(
                target_xy - data.qpos[:2]
            ))

            R_final = data.xmat[trunk_id].reshape(3, 3)
            final_yaw = float(np.arctan2(
                R_final[1, 0], R_final[0, 0]
            ))
            final_yaw_error = (
                target_yaw - final_yaw + np.pi
            ) % (2.0 * np.pi) - np.pi

            print("Waypoint final position:", np.round(data.qpos[:3], 3))
            print("Waypoint position error:", round(final_distance, 3), "m")
            print("Waypoint heading error:", round(
                np.degrees(final_yaw_error), 2
            ), "deg")

            if final_distance > 0.12 or abs(final_yaw_error) > 0.18:
                raise RuntimeError(
                    f"Waypoint was not reached accurately: {label}"
                )
'''

code = replace_once(
    code,
    '        print("INTEGRATED TABLE A PICKUP + LIFT")',
    waypoint_helper + '\n        print("INTEGRATED TABLE A PICKUP + LIFT")',
    "Waypoint controller insertion",
)


