phase9_marker = code.index("PHASE 9: WALK WHILE CARRYING")
start = code.rfind("        print(", 0, phase9_marker)
if start < 0:
    raise RuntimeError("Could not locate the actual Phase 9 print statement.")

end = code.index(phase12_start, start)

new_transfer = '''        # =========================================================
        # PHASE 9: CARRY BOX ALONG THE OUTSIDE SOUTH LANE
        # =========================================================
        print("\\nPHASE 9: CARRY BOX OUTSIDE BOTH TABLES")

        def current_yaw_deg():
            R = data.xmat[trunk_id].reshape(3, 3)
            return float(np.degrees(np.arctan2(R[1, 0], R[0, 0])))

        handoff_position = data.qpos[:2].copy()
        robot_before_walk = data.qpos[:3].copy()
        object_before_walk = data.mocap_pos[mocap_id].copy()

        print("Robot at carry handoff:", np.round(robot_before_walk, 3))
        print("Object at carry handoff:", np.round(object_before_walk, 3))
        print("Outside lane Y:", SOUTH_LANE_Y)

        if data.qpos[1] > -0.70:
            raise RuntimeError(
                "Robot entered the table footprint before carrying."
            )

        # Keep the pickup heading during the transfer. Turning the torso
        # here would swing the hand-attached box away from the table edge.
        run_teacher_waypoint(
            np.array([1.50, SOUTH_LANE_Y]),
            PICKUP_YAW,
            "PHASE 9: WALK EAST ALONG THE OUTSIDE SOUTH LANE",
            carry=True,
            timeout_seconds=50.0,
        )

        robot_after_walk = data.qpos[:3].copy()
        object_after_walk = data.mocap_pos[mocap_id].copy()

        print("\\n========== OUTSIDE TABLE TRANSFER RESULTS ==========")
        print("Robot before transfer:", np.round(robot_before_walk, 3))
        print("Robot after transfer:", np.round(robot_after_walk, 3))
        print("Robot displacement:", np.round(
            robot_after_walk[:2] - robot_before_walk[:2], 3
        ))
        print("Box before transfer:", np.round(object_before_walk, 3))
        print("Box after transfer:", np.round(object_after_walk, 3))
        print("Robot heading:", round(current_yaw_deg(), 2), "degrees")

        if data.qpos[1] > -0.70:
            raise RuntimeError(
                "Robot left the outside lane during the transfer. "
                f"Base Y={data.qpos[1]:.3f}."
            )

        if not (
            1.20 <= object_after_walk[0] <= 1.92
            and -0.575 <= object_after_walk[1] <= -0.07
        ):
            raise RuntimeError(
                "Carried box is not safely over Table B. "
                f"Actual position={np.round(object_after_walk, 3)}"
            )

        if object_after_walk[1] > -0.30:
            raise RuntimeError(
                "Box reached Table B but is not near its south edge. "
                f"Actual Y={object_after_walk[1]:.3f}"
            )

        print("Robot remained outside the table footprint.")
        print("Box reached the south side of Table B.")

'''

code = code[:start] + new_transfer + code[end:]


