# FINAL STABILITY AND TEACHER PLACEMENT PATCH

def _replace_final(text, old, new, label):
    count = text.count(old)
    if count == 1:
        return text.replace(old, new, 1)
    if count == 0 and new in text:
        return text
    raise RuntimeError(
        f"{label}: expected one match, found {count}."
    )

# Extend the original teacher-phase helper to smoothly move the arm.
_fn_a = code.index("        def run_teacher_phase(")
_fn_b = code.index("\n\n        def run_teacher_waypoint(", _fn_a)
_fn = code[_fn_a:_fn_b]

_fn = _replace_final(
    _fn,
    "def run_teacher_phase(seconds, vx, vy, yaw, label, carry_offset=None):",
    "def run_teacher_phase(seconds, vx, vy, yaw, label, carry_offset=None, arm_target=None):",
    "Teacher arm-target argument",
)
_fn = _replace_final(
    _fn,
    "            count = round(seconds / policy_dt)",
    """            count = max(1, round(seconds / policy_dt))
            arm_start = None
            if arm_target is not None:
                arm_joint_ids = model.actuator_trnid[arm_ids, 0].astype(int)
                arm_qpos_ids = model.jnt_qposadr[arm_joint_ids].astype(int)
                arm_start = data.qpos[arm_qpos_ids].copy()""",
    "Teacher arm starting pose",
)
_fn = _replace_final(
    _fn,
    "                obs, _, terminated, truncated, _ = env.step(action)",
    """                if arm_target is not None:
                    arm_blend = smooth((i + 1) / count)
                    env.home_ctrl[arm_ids] = (
                        arm_start
                        + arm_blend * (
                            np.asarray(arm_target, dtype=float) - arm_start
                        )
                    )

                obs, _, terminated, truncated, _ = env.step(action)""",
    "Teacher arm ramp",
)
code = code[:_fn_a] + _fn + code[_fn_b:]

code = _replace_final(
    code,
    "stable_required = max(1, round(0.12 / policy_dt))",
    "stable_required = max(1, round(0.80 / policy_dt))",
    "Waypoint settling duration",
)

code = _replace_final(
