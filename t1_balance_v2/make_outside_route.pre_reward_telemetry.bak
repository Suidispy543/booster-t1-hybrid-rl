        start_xy = data.qpos[:2].copy()
        start_R = data.xmat[trunk_id].reshape(3, 3)
        start_yaw = float(np.arctan2(start_R[1, 0], start_R[0, 0]))

        print("\\nPHASE 1: MOVE TO THE WEST SIDE OF TABLE A")
