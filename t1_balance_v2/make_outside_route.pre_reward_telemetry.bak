            PICKUP_YAW,
            "PHASE 1B: APPROACH TABLE A FROM ITS SOUTH EDGE",
            timeout_seconds=35.0,
        )

        if data.qpos[1] > -0.70:
            raise RuntimeError(
                "Robot is not outside Table A. "
                f"Base Y={data.qpos[1]:.3f}; expected Y <= -0.70."
            )

        print("Outside Table A approach completed.")
        print("Robot pickup position:", np.round(data.qpos[:3], 3))
'''

code = replace_once(
